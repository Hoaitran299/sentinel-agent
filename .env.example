# Copy file này thành .env, chmod 600, rồi điền token của GitHub bot riêng.
# Token không được truyền vào Claude Code hoặc Laravel.
AI_FIX_PUBLISH_PR=false
AI_FIX_GITHUB_TOKEN=
AI_FIX_GITHUB_REPOSITORY=nguyenthanhthuc2000/demo-agent-ai-auto-fix-bug
AI_FIX_GITHUB_API_URL=https://api.github.com
AI_FIX_GITHUB_GIT_URL=https://github.com/nguyenthanhthuc2000/demo-agent-ai-auto-fix-bug.git
AI_FIX_GITHUB_DRAFT=true

# State store MySQL của orchestrator: database riêng `ai_fix_orchestrator`, user/pass sentinel/sentinel.
# Khi chạy Docker, compose.yaml của sentinel-demo-app đặt sẵn biến này (ghi đè giá trị ở đây).
# Để trống thì fallback về SQLite `state_db` (chỉ nên dùng cho test).
AI_FIX_DATABASE_URL=mysql://sentinel:sentinel@mysql:3306/ai_fix_orchestrator

# Ngôn ngữ của Markdown report, failure report, nội dung PR và phần phân tích Claude viết.
# Giá trị: en (English, mặc định) | vi (tiếng Việt) | ja (日本語).
AI_FIX_REPORT_LANGUAGE=vi

# Thông báo Telegram (gửi bởi watcher; token không bao giờ được đưa cho Claude).
# Tạo bot qua @BotFather, thêm bot vào group/channel, lấy chat id (group thường có dạng -100...).
AI_FIX_TELEGRAM_ENABLED=false
AI_FIX_TELEGRAM_BOT_TOKEN=
AI_FIX_TELEGRAM_CHAT_ID=
# Sự kiện gửi đi (mặc định 6 cái đầu): reported,started,succeeded,failed,pr_merged,pr_closed,repeated
AI_FIX_TELEGRAM_EVENTS=reported,started,succeeded,failed,pr_merged,pr_closed

# Nguồn log Laravel: file (mặc định) | http | ssh | s3 — xem docs/log-sources.md
AI_FIX_LOG_SOURCE=file
# Nguồn remote được poll mỗi N giây (s3 tối thiểu 10).
AI_FIX_LOG_POLL_SECONDS=10
# file: ghi đè log_path trong config/demo.json (tùy chọn)
AI_FIX_LOG_PATH=
# http: file log được serve qua HTTP(S) có hỗ trợ Range (nginx + auth)
AI_FIX_LOG_HTTP_URL=
AI_FIX_LOG_HTTP_TOKEN=
AI_FIX_LOG_HTTP_USERNAME=
AI_FIX_LOG_HTTP_PASSWORD=
# ssh: tail file trên server khác bằng SSH key (BatchMode, cần known_hosts)
AI_FIX_LOG_SSH_HOST=
AI_FIX_LOG_SSH_USER=
AI_FIX_LOG_SSH_PORT=22
AI_FIX_LOG_SSH_KEY=
AI_FIX_LOG_SSH_PATH=
# s3: AWS S3 / Cloudflare R2 / MinIO (cần `make install-s3`). Đặt KEY hoặc PREFIX.
# R2: AI_FIX_LOG_S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com, REGION=auto
AI_FIX_LOG_S3_BUCKET=
AI_FIX_LOG_S3_KEY=
AI_FIX_LOG_S3_PREFIX=
AI_FIX_LOG_S3_ENDPOINT=
AI_FIX_LOG_S3_REGION=
AI_FIX_LOG_S3_ACCESS_KEY_ID=
AI_FIX_LOG_S3_SECRET_ACCESS_KEY=

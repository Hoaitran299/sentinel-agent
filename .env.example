# Môi trường demo chạy bằng Docker (xem ../sentinel-demo-app/docs/setup/docker.md).
# Copy thành .env, chmod 600. Token không được truyền vào Claude Code hoặc Laravel.
# AI_FIX_DATABASE_URL do compose.yaml đặt (user/pass sentinel, DB ai_fix_orchestrator).
# Log đọc từ file /workspace/laravel/storage/logs/laravel.log (config/docker.json).

# GitHub publisher: false = chỉ tạo branch + commit + report ở local, không push/PR.
AI_FIX_PUBLISH_PR=false
AI_FIX_GITHUB_TOKEN=
AI_FIX_GITHUB_REPOSITORY=Hoaitran299/sentinel-demo-web
AI_FIX_GITHUB_GIT_URL=https://github.com/Hoaitran299/sentinel-demo-web.git

# Ngôn ngữ report/PR: en | vi | ja
AI_FIX_REPORT_LANGUAGE=vi

# Thông báo Telegram (tùy chọn). Tạo bot qua @BotFather, lấy chat id của group/channel.
AI_FIX_TELEGRAM_ENABLED=false
AI_FIX_TELEGRAM_BOT_TOKEN=
AI_FIX_TELEGRAM_CHAT_ID=
